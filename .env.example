# TypeSafe AI API key — get one at https://typesafe.ai
TYPESAFE_API_KEY=

# Optional: override the default Jev model (defaults to "jev-latest")
# TYPESAFE_DEFAULT_MODEL=jev-latest

# LLM comparison (Experiment A/B --providers openai:<model> / gemini:<model>).
# Read directly by each provider's own SDK, not by this project's config --
# only set the one(s) you actually use.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
